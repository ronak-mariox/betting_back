NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/betting_platform

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Generate real random strings for these before deploying anywhere real,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

BCRYPT_SALT_ROUNDS=12

# Root super-admin bootstrapped on first boot if none exists yet.
# Outside production these fall back to the bettingWeb Quick Demo Login
# credentials (mithu8178 / superadmin@123).
SUPER_ADMIN_USERNAME=mithu8178
SUPER_ADMIN_PASSWORD=superadmin@123

# Set to "true" to also seed the demo franchise/super-agent/agent chain in production.
SEED_DEMO_DATA=false

# Outgoing mail for "Forgot password?" reset codes. Leave SMTP_HOST empty in
# development and the code is printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RESET_CODE_TTL_MINUTES=10
# Fixed reset code accepted for any account while testing (default 123456). Ignored when NODE_ENV=production.
RESET_MASTER_CODE=123456

# Diamond cricket feed. Leave DIAMOND_API_KEY empty to turn the sync off.
DIAMOND_BASE_URL=http://46.202.166.33:3009
DIAMOND_API_KEY=
DIAMOND_STREAM_URL=https://live.cricketid.xyz/directStream?gmid=
DIAMOND_SCORE_URL=https://score.akamaized.uk/diamond-live-score?gmid=
